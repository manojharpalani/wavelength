# Copy to .env.local and fill in your keys.
ANTHROPIC_API_KEY=

# Optional: sign-in + saved manuals. Leave blank and the app works exactly
# as before (no accounts, everything in-memory for the session). Get these
# from a Supabase project's dashboard: Project Settings -> API. The anon
# key is safe to expose to the browser by design — row-level security in
# supabase/schema.sql is what actually protects the data. See
# docs/DECISIONS.md for the full setup steps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
